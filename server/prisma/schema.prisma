model Sigil {
id           Int          @id @default(autoincrement())
me         String       @db.VarChar(100)
erId       Int
tention    String?      @db.Text
nvasData   String?      @db.LongText
ageData    String?      @db.LongText
Charged    Boolean      @default(false)
cationName String?      @db.VarChar(200)
titude     Decimal?     @db.Decimal(10, 8)
ngitude    Decimal?     @db.Decimal(11, 8)
eatedAt    DateTime     @default(now())
gilGroups  SigilGroup[]
er         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

                              @@map("sigils")
}                            

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)  // ← add
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascad  // ← adde) // ← add
 // ← add
  @@unique([followerId, followingId])
}




model SigilGroup {
          Int    @id @default(autoincrement())
gilId     Int
oupMember String @db.VarChar(100)
gil       Sigil  @relation(fields: [sigilId], references: [id], onDelete: Cascade)

index([sigilId], map: "sigil_groups_sigilId_fkey")
map("sigil_groups")
}

model SvgVector {
         Int      @id @default(autoincrement())
