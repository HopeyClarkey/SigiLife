model User {
           Int      @id @default(autoincrement())
ername     String?  @unique @db.VarChar(100)
ail        String   @unique @db.VarChar(255)
me         String?  @db.VarChar(255)
cture      String?  @db.VarChar(500)
ogleId     String?  @unique @db.VarChar(255)
